<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<OutputType>Library</OutputType>
		<AssemblyName>AC_SpectatorMode</AssemblyName>
		<RootNamespace>AC_SpectatorMode</RootNamespace>
		<!-- Writes these into the DLL, so Windows' file properties show the real version.
		     Keep in step with Plugin.Version. -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<Product>AC_SpectatorMode</Product>
		<AssemblyTitle>AC_SpectatorMode</AssemblyTitle>
		<Description>Points Aicomi's overworld camera at another character and follows them.</Description>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.752" />
	</ItemGroup>

	<!--
		The interop assemblies are generated by BepInEx from the game on first launch and are
		not redistributable, so they are referenced from the local install rather than committed.
		Anyone else building this points InteropPath at their own install, e.g.
		dotnet build -p:InteropPath="E:\Games\Aicomi\BepInEx\interop-Aicomi\interop"
	-->
	<!-- Copy Local.props.example to Local.props and point it at your own game folder
	     (Local.props is not tracked by git), or pass -p:InteropPath="..." on the command line. -->
	<Import Project="$(MSBuildThisFileDirectory)..\Local.props"
	        Condition="Exists('$(MSBuildThisFileDirectory)..\Local.props')" />

	<Target Name="CheckInteropPath" BeforeTargets="BeforeBuild">
		<Error Condition="'$(InteropPath)' == ''"
		       Text="InteropPath is not set. Copy Local.props.example to Local.props and point it at your game's interop folder (BepInEx\interop-Aicomi\interop on an HF Patch install)." />
		<Error Condition="!Exists('$(InteropPath)')"
		       Text="No interop assemblies at &quot;$(InteropPath)&quot;. Run the game once with BepInEx installed so it can generate them, then check the path in Local.props." />
	</Target>

	<ItemGroup>
		<Reference Include="$(InteropPath)\*.dll">
			<Private>false</Private>
		</Reference>
	</ItemGroup>
</Project>
